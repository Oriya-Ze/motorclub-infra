# Copy to terraform.tfvars and set backend_image_tag before apply.
# Do not commit terraform.tfvars.

aws_region        = "eu-central-1"
project_name      = "motorclub"
environment       = "dev"
backend_image_tag = "REPLACE_WITH_GIT_SHA"

enable_custom_domains   = false
manage_route53_records  = false
# route53_hosted_zone_id = "Z1234567890ABC"

enable_waf                     = false
allow_broad_media_cors_in_dev  = true
