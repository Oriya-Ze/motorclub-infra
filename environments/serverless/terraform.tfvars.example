# Copy to terraform.tfvars and set secrets before apply.
# Do not commit terraform.tfvars.

aws_region         = "eu-central-1"
project_name       = "motorclub"
environment        = "serverless"
lambda_image_tag            = "REPLACE_WITH_GIT_SHA"
transcode_lambda_image_tag  = "REPLACE_WITH_GIT_SHA"

# Neon connection string (asyncpg + SSL required):
# postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
database_url = "REPLACE_WITH_NEON_DATABASE_URL"

enable_custom_domains  = false
manage_route53_records = false
# create_route53_zone    = true   # set when creating a new Route 53 zone
# route53_hosted_zone_id = "Z1234567890ABC"
allow_broad_media_cors = true

# Google OAuth (optional — enables "Sign in with Google" via Cognito)
# cognito_domain_prefix = "motorclub-serverless"
# google_oauth_client_id     = "REPLACE.apps.googleusercontent.com"
# google_oauth_client_secret = "REPLACE"

# Cloudflare Turnstile CAPTCHA (free) — https://dash.cloudflare.com/?to=/:account/turnstile
# turnstile_site_key   = "REPLACE"
# turnstile_secret_key = "REPLACE"
#
# In Google Cloud Console, add this Authorized redirect URI:
# https://motorclub-serverless.auth.eu-central-1.amazoncognito.com/oauth2/idpresponse
